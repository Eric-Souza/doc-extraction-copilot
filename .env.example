# Free key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: another Gemini model (the default is gemini-3.5-flash-lite)
AI_MODEL=
# Optional: "mock" runs the app against a scripted model, with no key
AI_PROVIDER=
# Optional: the Guardrails server in guard/ (http://localhost:8100). A reading that fails a check is read again
GUARD_URL=
# Optional: a Phoenix to trace to (http://localhost:6006 for a local one)
PHOENIX_COLLECTOR_ENDPOINT=
